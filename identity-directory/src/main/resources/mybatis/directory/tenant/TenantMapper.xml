<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zyaire.identity.directory.infrastructure.persistence.tenant.TenantMapper">
  <!-- nextval 每次都必须访问数据库；清除一级缓存并禁用二级缓存。 -->
  <select id="nextLearningId" resultType="long" flushCache="true" useCache="false">
    SELECT nextval('platform_meta.learning_id_seq')
  </select>
  <insert id="insert">
    INSERT INTO directory.tenant(id, name, code, status, version)
    VALUES (#{row.id}, #{row.name}, #{row.code}, #{row.status}, #{row.version})
  </insert>
  <resultMap id="tenantRow" type="com.zyaire.identity.directory.infrastructure.persistence.tenant.TenantRow">
    <constructor>
      <idArg column="id" javaType="_long"/>
      <arg column="name" javaType="java.lang.String"/>
      <arg column="code" javaType="java.lang.String"/>
      <arg column="status" javaType="java.lang.String"/>
      <arg column="version" javaType="_long"/>
    </constructor>
  </resultMap>
  <select id="findById" resultMap="tenantRow">
    SELECT id, name, code, status, version FROM directory.tenant WHERE id = #{id}
  </select>
</mapper>
